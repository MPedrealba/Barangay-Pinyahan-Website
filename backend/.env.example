# ============================================
# backend/.env.example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================

# Server Configuration
PORT=

# TiDB Cloud Serverless Connection
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_SSL=

# JWT Secret — use a long random string in production (min 32 chars)
JWT_SECRET=

# OpenRouter API Key (for AI complaint classification)
OPENROUTER_API_KEY=

# Supabase Storage (for persistent image uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS — set to your deployed frontend URL in production
ALLOWED_ORIGIN=

# reCAPTCHA v3 Secret Key
RECAPTCHA_SECRET_KEY=
